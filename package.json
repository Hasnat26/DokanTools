{
  "name": "dokantools",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --test tests/*.test.mjs",
    "verify:sql": "node scripts/verify-sql.mjs",
    "perf": "node scripts/performance-benchmark.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run verify:sql && npm run perf",
    "typecheck": "tsc --noEmit",
    "test:invoice:postgres": "bash scripts/test-invoice-postgres.sh",
    "demo:draft-memo": "node scripts/serve-draft-memo-demo.mjs",
    "finalize:draft-memo:pdf": "node scripts/finalize-a6-pdf.mjs",
    "verify:draft-memo:pdf": "node scripts/verify-a6-pdf.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "jspdf": "^4.2.1",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
